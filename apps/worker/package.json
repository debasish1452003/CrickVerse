{
  "name": "@crickverse/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/main.ts",
    "start": "dotenv -e ../../.env -- tsx src/main.ts",
    "seed": "dotenv -e ../../.env -- tsx src/cli.ts seed",
    "probe": "dotenv -e ../../.env -- tsx src/cli.ts probe",
    "cricsheet:seed-feeds": "dotenv -e ../../.env -- tsx src/cli.ts cricsheet-seed-feeds",
    "cricsheet:sync": "dotenv -e ../../.env -- tsx src/cli.ts cricsheet-sync",
    "cricsheet:export": "dotenv -e ../../.env -- tsx src/cli.ts cricsheet-export-parquet",
    "cricsheet:gold": "dotenv -e ../../.env -- tsx src/cli.ts cricsheet-build-gold",
    "lakehouse:refresh": "dotenv -e ../../.env -- tsx src/cli.ts lakehouse-refresh",
    "cricsheet:missing": "dotenv -e ../../.env -- tsx src/cli.ts cricsheet-missing-import",
    "official-stats:import": "dotenv -e ../../.env -- tsx src/cli.ts official-stats-import",
    "historical-scorecard:import": "dotenv -e ../../.env -- tsx src/cli.ts historical-scorecard-import",
    "cricinfo:discover": "dotenv -e ../../.env -- tsx src/cli.ts cricinfo-historical-discover",
    "cricinfo:sync": "dotenv -e ../../.env -- tsx src/cli.ts cricinfo-historical-sync",
    "recover:player-careers": "dotenv -e ../../.env -- tsx src/cli.ts recover-player-careers",
    "import:bulk-innings": "dotenv -e ../../.env -- tsx src/cli.ts import-bulk-innings",
    "import:kaggle-innings": "dotenv -e ../../.env -- tsx src/cli.ts import-kaggle-innings",
    "historical:export-silver": "dotenv -e ../../.env -- tsx src/cli.ts historical-export-silver",
    "ml:features": "dotenv -e ../../.env -- tsx src/cli.ts build-ml-features",
    "coverage:audit": "dotenv -e ../../.env -- tsx src/cli.ts coverage-audit",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "echo \"(no tests in @crickverse/worker)\""
  },
  "dependencies": {
    "@crickverse/db": "workspace:*",
    "@crickverse/domain": "workspace:*",
    "@crickverse/lakehouse": "workspace:^",
    "@crickverse/scraper-core": "workspace:*",
    "@crickverse/types": "workspace:*",
    "node-cron": "^3.0.3",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "@types/yauzl": "^3.3.0",
    "dotenv-cli": "^7.4.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
