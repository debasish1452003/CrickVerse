# ── Database (Neon Postgres) ───────────────────────────────────────────────
# Create a free project at https://neon.tech, then copy the connection strings.
# DATABASE_URL = the POOLED connection string (host contains "-pooler").
# DIRECT_URL   = the DIRECT (non-pooled) string — used by `prisma migrate`.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/crickverse?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/crickverse?sslmode=require"

# ── Auth.js (NextAuth v5) ──────────────────────────────────────────────────
# Generate AUTH_SECRET with:  npx auth secret    (or: openssl rand -base64 32)
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Google OAuth client: https://console.cloud.google.com → APIs & Services →
# Credentials → Create OAuth client ID → Web application.
# Authorized redirect URI:  http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Scraper / worker ───────────────────────────────────────────────────────
SCRAPER_ENABLED="true"
SCRAPER_CONCURRENCY="2"
SCRAPER_MIN_GAP_MS="1000"
SCRAPER_MAX_RETRIES="4"
# Live re-scrape cadence (5-field cron). Default: every 2 minutes.
SCRAPER_LIVE_CRON="*/2 * * * *"
# Historical backfill cadence. Default: hourly at minute 17.
SCRAPER_BACKFILL_CRON="17 * * * *"

# Active series to track (comma-separated slug-objectId pairs), e.g. "ipl-2026-1510719".
SCRAPER_ACTIVE_SERIES="ipl-2026-1510719"
