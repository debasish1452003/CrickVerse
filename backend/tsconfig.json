{
  "compilerOptions": {
    /* =========================
       MODULE + TARGET (CRITICAL)
    ========================== */
    "module": "NodeNext",
    "target": "ES2022",
    "moduleResolution": "NodeNext",

    /* =========================
       PROJECT STRUCTURE
    ========================== */
    "rootDir": "./src",
    "outDir": "./dist",

    /* =========================
       NODE SUPPORT
    ========================== */
    "types": ["node"],
    "lib": ["ES2022"],

    /* =========================
       DEVELOPMENT FEATURES
    ========================== */
    "sourceMap": true,

    /* =========================
       STRICTNESS (KEEP THESE)
    ========================== */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    /* =========================
       MODULE BEHAVIOR
    ========================== */
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",

    /* =========================
       PERFORMANCE
    ========================== */
    "skipLibCheck": true
  },
  "include": ["src/**/*"]
}